{
  "schema": "nekkora-rpa/selectors",
  "version": "1.0.0",
  "system": "pedidos",
  "targets": {
    "pedidos.login.usuario": {"page": "login", "preferred": {"strategy": "name", "value": "login"},
                              "expected": {"tag": "input", "type": "text", "role": "textbox", "name": "Login do operador"}},
    "pedidos.login.senha": {"page": "login", "preferred": {"strategy": "name", "value": "pass"},
                            "expected": {"tag": "input", "type": "password"}},
    "pedidos.login.acessar": {"page": "login", "preferred": {"strategy": "test_id", "value": "acessar"},
                              "expected": {"tag": "button", "role": "button", "name": "Acessar"}},
    "pedidos.login.erro": {"page": "login", "preferred": {"strategy": "css", "expression": ".campos .msg"},
                           "expected": {"tag": "p", "role": "alert"}},

    "pedidos.novo.titulo": {"page": "novo", "preferred": {"strategy": "id", "value": "titulo-novo"},
                            "expected": {"tag": "h1", "role": "heading", "name": "Novo pedido"}},
    "pedidos.novo.referencia": {"page": "novo", "preferred": {"strategy": "id", "value": "referencia"},
                                "expected": {"tag": "input", "type": "text", "role": "textbox", "name": "Referência do cliente"}},
    "pedidos.novo.produto": {"page": "novo", "preferred": {"strategy": "id", "value": "produto"},
                             "expected": {"tag": "input", "type": "text", "role": "textbox", "name": "Código do produto"}},
    "pedidos.novo.quantidade": {"page": "novo", "preferred": {"strategy": "id", "value": "quantidade"},
                                "expected": {"tag": "input", "type": "text", "role": "textbox", "name": "Quantidade"}},
    "pedidos.novo.observacao": {"page": "novo", "preferred": {"strategy": "id", "value": "observacao"},
                                "expected": {"tag": "textarea", "role": "textbox", "name": "Observação"}},
    "pedidos.novo.revisar": {"page": "novo", "preferred": {"strategy": "xpath", "expression": "//div[@id='form-pedido']//button[@id='revisar']"},
                             "expected": {"tag": "button", "role": "button", "name": "Revisar"}},
    "pedidos.novo.revisao": {"page": "novo", "preferred": {"strategy": "id", "value": "revisao"},
                             "expected": {"tag": "section", "role": "region", "name": "Revisão do pedido"}},
    "pedidos.novo.confirmar": {"page": "novo", "preferred": {"strategy": "role", "role": "button", "name": "Confirmar pedido"},
                               "expected": {"tag": "button", "role": "button", "name": "Confirmar pedido"}},
    "pedidos.novo.protocolo": {"page": "novo", "preferred": {"strategy": "id", "value": "protocolo"},
                               "expected": {"tag": "p", "role": "status"}},
    "pedidos.novo.erro_negocio": {"page": "novo", "preferred": {"strategy": "id", "value": "erro-negocio"},
                                  "expected": {"tag": "p", "role": "alert"}},
    "pedidos.novo.erro_servico": {"page": "novo", "preferred": {"strategy": "id", "value": "erro-servico"},
                                  "expected": {"tag": "p", "role": "alert"}},
    "pedidos.novo.erro_comunicacao": {"page": "novo", "preferred": {"strategy": "id", "value": "erro-comunicacao"},
                                      "expected": {"tag": "p", "role": "alert"}},
    "pedidos.novo.novo": {"page": "novo", "preferred": {"strategy": "id", "value": "novo"},
                          "expected": {"tag": "button", "role": "button", "name": "Novo pedido"}},

    "pedidos.lista.titulo": {"page": "lista", "preferred": {"strategy": "id", "value": "titulo-lista"},
                             "expected": {"tag": "h1", "role": "heading", "name": "Pedidos por referência"}},
    "pedidos.lista.referencia": {"page": "lista", "preferred": {"strategy": "id", "value": "busca-ref"},
                                 "expected": {"tag": "input", "type": "text", "role": "textbox", "name": "Referência"}},
    "pedidos.lista.buscar": {"page": "lista", "preferred": {"strategy": "id", "value": "buscar"},
                             "expected": {"tag": "button", "role": "button", "name": "Buscar"}},
    "pedidos.lista.resultado": {"page": "lista", "preferred": {"strategy": "id", "value": "lista-resultado"},
                                "expected": {"tag": "section", "role": "region", "name": "Pedidos encontrados"}},
    "pedidos.lista.total": {"page": "lista", "preferred": {"strategy": "id", "value": "lista-total"},
                            "expected": {"tag": "span"}},
    "pedidos.lista.protocolos": {"page": "lista", "preferred": {"strategy": "id", "value": "lista-protocolos"},
                                 "expected": {"tag": "ul", "role": "list"}},
    "pedidos.lista.vazia": {"page": "lista", "preferred": {"strategy": "id", "value": "lista-vazia"},
                            "expected": {"tag": "p", "role": "status"}},
    "pedidos.lista.erro": {"page": "lista", "preferred": {"strategy": "id", "value": "lista-erro"},
                           "expected": {"tag": "p", "role": "alert"}}
  }
}
